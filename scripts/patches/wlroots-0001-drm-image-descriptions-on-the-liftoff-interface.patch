From 012801c2d52ffe13c39386b7a0db91a1bb521b22 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Mon, 3 Aug 2026 12:00:00 +0200
Subject: [PATCH 1/5] backend/drm: set the image description props on the
 liftoff interface

The liftoff interface never set Colorspace or HDR_OUTPUT_METADATA, and the
guard that noticed spelled the condition as iface != &atomic_iface - which is
also true of the liftoff interface, even though libliftoff drives the same
atomic API.

The result is not a colour-management fallback but a dead output: every test
and every commit that carries an image description is refused, so a compositor
that attaches one to each frame cannot present at all once libliftoff is in
use.

Both values are already computed by the shared drm_atomic_connector_prepare(),
and the metadata blob is freed by the shared apply/rollback, so the interface
only had to put them in the request. Narrow the guard to the legacy interface,
which is the one with no atomic request to put them in.
---
 backend/drm/drm.c        |  4 ++--
 backend/drm/libliftoff.c | 15 +++++++++++++++
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/backend/drm/drm.c b/backend/drm/drm.c
index bd29872..6142ced 100644
--- a/backend/drm/drm.c
+++ b/backend/drm/drm.c
@@ -887,8 +887,8 @@ static bool drm_connector_prepare(struct wlr_drm_connector_state *conn_state, bo
 	}
 
 	if ((state->committed & WLR_OUTPUT_STATE_IMAGE_DESCRIPTION) &&
-			conn->backend->iface != &atomic_iface) {
-		wlr_log(WLR_DEBUG, "Image descriptions are only supported by the atomic interface");
+			conn->backend->iface == &legacy_iface) {
+		wlr_log(WLR_DEBUG, "Image descriptions are not supported by the legacy interface");
 		return false;
 	}
 
diff --git a/backend/drm/libliftoff.c b/backend/drm/libliftoff.c
index 333beac..28c34bd 100644
--- a/backend/drm/libliftoff.c
+++ b/backend/drm/libliftoff.c
@@ -320,6 +320,21 @@ static bool add_connector(drmModeAtomicReq *req,
 		ok = ok && add_prop(req, conn->id, conn->props.content_type,
 			DRM_MODE_CONTENT_TYPE_GRAPHICS);
 	}
+	/*
+	 * Colour management, the same two connector properties the atomic
+	 * interface sets. Both values are already computed for us by the shared
+	 * drm_atomic_connector_prepare(), and the metadata blob is freed by the
+	 * shared apply/rollback, so all that was missing was putting them in the
+	 * request.
+	 */
+	if (conn->props.colorspace != 0) {
+		ok = ok && add_prop(req, conn->id, conn->props.colorspace,
+			state->colorspace);
+	}
+	if (conn->props.hdr_output_metadata != 0) {
+		ok = ok && add_prop(req, conn->id, conn->props.hdr_output_metadata,
+			state->hdr_output_metadata);
+	}
 	// TODO: set "max bpc"
 	ok = ok &&
 		add_prop(req, crtc->id, crtc->props.mode_id, state->mode_id) &&
-- 
