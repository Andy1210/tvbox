From 02fa4d8421367ca8322af5de2a03abab655dfe66 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Mon, 3 Aug 2026 12:00:00 +0200
Subject: [PATCH 5/5] backend/drm: do not arm the composition layer while
 offloading

The composition layer catches whatever cannot be offloaded, and it is armed
with the same buffer at the same zpos as the primary layer. On hardware where
the primary is the only plane at that level - vc4 pins its zpos to 0 and marks
the property immutable - the two compete and libliftoff gives the plane to the
fallback, so the real content is composited even though the arrangement fits.

Asked directly on that hardware, libliftoff places a video layer and a UI layer
on a primary and an overlay with nothing composited, right up until the
composition layer joins them, at which point the video gets no plane at all.

When the compositor has said which layers it wants offloaded, leave the
fallback out of the contest.
---
 backend/drm/libliftoff.c | 47 +++++++++++++++++++++++++++++++++-------
 1 file changed, 39 insertions(+), 8 deletions(-)

diff --git a/backend/drm/libliftoff.c b/backend/drm/libliftoff.c
index b73da1e..def4413 100644
--- a/backend/drm/libliftoff.c
+++ b/backend/drm/libliftoff.c
@@ -367,25 +367,56 @@ static bool add_connector(drmModeAtomicReq *req,
 			ok = ok && add_prop(req, crtc->id, crtc->props.vrr_enabled, state->vrr_enabled);
 		}
 
+		/*
+		 * The composition layer is the fallback for whatever cannot be
+		 * offloaded, and it carries the same buffer at the same zpos as the
+		 * primary layer. Arming it unconditionally costs the primary plane on
+		 * hardware where that is the only plane at zpos 0 - vc4 pins the
+		 * primary's zpos there and marks it immutable - because both layers
+		 * then compete for it and libliftoff gives it to the fallback.
+		 *
+		 * Measured on that hardware, asking libliftoff directly: a video layer
+		 * and a UI layer land on the primary and an overlay with nothing
+		 * composited, right up until the composition layer joins them, at which
+		 * point the video gets no plane at all.
+		 *
+		 * So when the compositor has said which layers it wants offloaded, let
+		 * libliftoff place them and leave the fallback out of the contest. If
+		 * the allocation then fails, the commit fails and the compositor
+		 * composites the next frame - the same outcome as before, just no
+		 * longer the automatic one.
+		 */
+		bool offloading = (state->base->committed & WLR_OUTPUT_STATE_LAYERS) &&
+			state->base->layers_len > 0;
+
 		ok = ok && set_plane_props(crtc->primary,
 			crtc->primary->liftoff_layer, state->primary_fb, 0,
 			&state->primary_viewport.dst_box,
 			&state->primary_viewport.src_box);
-		ok = ok && set_plane_props(crtc->primary,
-			crtc->liftoff_composition_layer, state->primary_fb, 0,
-			&state->primary_viewport.dst_box,
-			&state->primary_viewport.src_box);
+		if (!offloading) {
+			ok = ok && set_plane_props(crtc->primary,
+				crtc->liftoff_composition_layer, state->primary_fb, 0,
+				&state->primary_viewport.dst_box,
+				&state->primary_viewport.src_box);
+		} else {
+			ok = ok && liftoff_layer_set_property(
+				crtc->liftoff_composition_layer, "FB_ID", 0) == 0;
+		}
 
 		liftoff_layer_set_property(crtc->primary->liftoff_layer,
 			"FB_DAMAGE_CLIPS", state->fb_damage_clips);
-		liftoff_layer_set_property(crtc->liftoff_composition_layer,
-			"FB_DAMAGE_CLIPS", state->fb_damage_clips);
+		if (!offloading) {
+			liftoff_layer_set_property(crtc->liftoff_composition_layer,
+				"FB_DAMAGE_CLIPS", state->fb_damage_clips);
+		}
 
 		if (state->primary_in_fence_fd >= 0) {
 			liftoff_layer_set_property(crtc->primary->liftoff_layer,
 				"IN_FENCE_FD", state->primary_in_fence_fd);
-			liftoff_layer_set_property(crtc->liftoff_composition_layer,
-				"IN_FENCE_FD", state->primary_in_fence_fd);
+			if (!offloading) {
+				liftoff_layer_set_property(crtc->liftoff_composition_layer,
+					"IN_FENCE_FD", state->primary_in_fence_fd);
+			}
 		}
 
 		if (state->base->committed & WLR_OUTPUT_STATE_LAYERS) {
-- 
