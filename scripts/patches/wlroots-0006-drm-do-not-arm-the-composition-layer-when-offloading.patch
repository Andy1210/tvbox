From 348c1517a8a91e2ff07a3d673e72e63f8b0d096e Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Mon, 3 Aug 2026 18:00:00 +0200
Subject: [PATCH 6/6] backend/drm: do not arm the composition layer while
 offloading

The composition layer catches whatever cannot be offloaded, and it is armed with
the same buffer at the same zpos as the primary layer. On hardware where the
primary is the only plane at that level - vc4 pins its zpos to 0 and marks the
property immutable - the two compete and libliftoff gives the plane to the
fallback, so the real content is composited even though the arrangement fits.

Asked directly on that hardware, libliftoff places a video layer and a UI layer on
a primary and an overlay with nothing composited, right up until the composition
layer joins them, at which point the video gets no plane at all.

Leave the fallback out of the contest when a layer is actually armed; a state that
only describes disabled layers keeps it, since a layer with no framebuffer never
gets a plane and so cannot take one from anything. Because nothing else then
covers an allocation that leaves the primary layer out, check that the frame
reached a plane at all - either layer will do, they carry the same buffer.
---
 backend/drm/libliftoff.c | 77 +++++++++++++++++++++++++++++++++++-----
 1 file changed, 69 insertions(+), 8 deletions(-)

diff --git a/backend/drm/libliftoff.c b/backend/drm/libliftoff.c
index a554b81..02fd6b5 100644
--- a/backend/drm/libliftoff.c
+++ b/backend/drm/libliftoff.c
@@ -363,25 +363,68 @@ static bool add_connector(drmModeAtomicReq *req,
 			ok = ok && add_prop(req, crtc->id, crtc->props.vrr_enabled, state->vrr_enabled);
 		}
 
+		/*
+		 * The composition layer is the fallback for whatever cannot be
+		 * offloaded, and it carries the same buffer at the same zpos as the
+		 * primary layer. Arming it unconditionally costs the primary plane on
+		 * hardware where that is the only plane at zpos 0 - vc4 pins the
+		 * primary's zpos there and marks it immutable - because both layers
+		 * then compete for it and libliftoff gives it to the fallback.
+		 *
+		 * Measured on that hardware, asking libliftoff directly: a video layer
+		 * and a UI layer land on the primary and an overlay with nothing
+		 * composited, right up until the composition layer joins them, at which
+		 * point the video gets no plane at all.
+		 *
+		 * So when the compositor has ARMED a layer, let libliftoff place it and
+		 * leave the fallback out of the contest. A state that only describes
+		 * disabled layers is not offloading anything and keeps its fallback: an
+		 * unarmed layer carries no framebuffer and libliftoff never gives it a
+		 * plane, so there would be nothing for the fallback to lose the plane to.
+		 *
+		 * If the allocation then cannot place the armed layer, libliftoff marks it
+		 * as needing composition and the commit still succeeds - so the frame goes
+		 * out without that layer, and the compositor learns from the layer's
+		 * accepted flag that it has to composite the next one.
+		 */
+		bool offloading = false;
+		if (state->base->committed & WLR_OUTPUT_STATE_LAYERS) {
+			for (size_t i = 0; i < state->base->layers_len; i++) {
+				if (state->base->layers[i].buffer != NULL) {
+					offloading = true;
+					break;
+				}
+			}
+		}
+
 		ok = ok && set_plane_props(crtc->primary,
 			crtc->primary->liftoff_layer, state->primary_fb, 0,
 			&state->primary_viewport.dst_box,
 			&state->primary_viewport.src_box);
-		ok = ok && set_plane_props(crtc->primary,
-			crtc->liftoff_composition_layer, state->primary_fb, 0,
-			&state->primary_viewport.dst_box,
-			&state->primary_viewport.src_box);
+		if (!offloading) {
+			ok = ok && set_plane_props(crtc->primary,
+				crtc->liftoff_composition_layer, state->primary_fb, 0,
+				&state->primary_viewport.dst_box,
+				&state->primary_viewport.src_box);
+		} else {
+			ok = ok && liftoff_layer_set_property(
+				crtc->liftoff_composition_layer, "FB_ID", 0) == 0;
+		}
 
 		liftoff_layer_set_property(crtc->primary->liftoff_layer,
 			"FB_DAMAGE_CLIPS", state->fb_damage_clips);
-		liftoff_layer_set_property(crtc->liftoff_composition_layer,
-			"FB_DAMAGE_CLIPS", state->fb_damage_clips);
+		if (!offloading) {
+			liftoff_layer_set_property(crtc->liftoff_composition_layer,
+				"FB_DAMAGE_CLIPS", state->fb_damage_clips);
+		}
 
 		if (state->primary_in_fence_fd >= 0) {
 			liftoff_layer_set_property(crtc->primary->liftoff_layer,
 				"IN_FENCE_FD", state->primary_in_fence_fd);
-			liftoff_layer_set_property(crtc->liftoff_composition_layer,
-				"IN_FENCE_FD", state->primary_in_fence_fd);
+			if (!offloading) {
+				liftoff_layer_set_property(crtc->liftoff_composition_layer,
+					"IN_FENCE_FD", state->primary_in_fence_fd);
+			}
 		}
 
 		if (state->base->committed & WLR_OUTPUT_STATE_LAYERS) {
@@ -509,6 +552,24 @@ static bool commit(struct wlr_drm_backend *drm,
 			wlr_drm_conn_log(conn, WLR_DEBUG, "Failed to scan-out cursor plane");
 			goto out;
 		}
+
+		/*
+		 * Whether the frame the compositor prepared reached a plane at all. The
+		 * primary layer and the composition fallback carry the SAME buffer, so
+		 * either one being placed means the frame is on screen - which is why the
+		 * question is about the planes and not about needs_composition, that being
+		 * true of whichever of the two libliftoff did not pick.
+		 *
+		 * With the fallback disarmed while a layer is offloaded, nothing else
+		 * covers an allocation that leaves the primary layer out: the commit would
+		 * scan out everything EXCEPT that frame, on a driver that tolerates an
+		 * active CRTC without a primary plane, and nothing downstream would know.
+		 */
+		if (liftoff_layer_get_plane(crtc->primary->liftoff_layer) == NULL &&
+				liftoff_layer_get_plane(crtc->liftoff_composition_layer) == NULL) {
+			wlr_drm_conn_log(conn, WLR_DEBUG, "Failed to scan-out primary plane");
+			goto out;
+		}
 	}
 
 	ok = drmModeAtomicCommit(drm->fd, req, flags, page_flip) == 0;
-- 
2.47.3

