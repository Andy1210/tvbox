From f55b46adec8d95299ac7f80fef13f2f43356a0d9 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Wed, 5 Aug 2026 11:06:06 +0200
Subject: [PATCH] output: apply <hdr> on reconfigure

<hdr> is output state, and reloading the config did not apply it: the new value
sat there until something else reconfigured the output - a mode change, a hotplug -
so a reload that changed only this setting did nothing at all, and a compositor
left in an HDR colour space stayed in it.

Set the HDR state up and commit it for every usable output at the end of a
reconfigure, silently: the reasons a set cannot do HDR were already reported when
the output came up.

This is what lets something outside the compositor drive the colour space at all.
On this box the shell claims HDR for the duration of PQ playback and releases it
after, which it does by writing the config and sending SIGHUP.
The commit is left to the next frame rather than done here. A reload runs whenever
the signal arrives, often enough on top of a page-flip already in flight, and a
failed commit leaves the render format on the long-lived pending state - which is
what makes wlr_scene refuse direct scan-out, so a film stops reaching a display
plane. The frame path commits that same state, so the colour space rides along
with the damage once the flip has completed.

---
 src/server.c | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/src/server.c b/src/server.c
index d0c8c04..13e633d 100644
--- a/src/server.c
+++ b/src/server.c
@@ -66,6 +66,7 @@
 #include "magnifier.h"
 #include "menu/menu.h"
 #include "output.h"
+#include "output-state.h"
 #include "output-virtual.h"
 #include "regions.h"
 #include "resize-indicator.h"
@@ -119,6 +120,32 @@ reload_config_and_theme(void)
 	resize_indicator_reconfigure();
 	kde_server_decoration_update_default();
 	workspaces_reconfigure();
+
+	/*
+	 * <hdr> is output state, and until now nothing here applied it: the new
+	 * value sat in the config until something else reconfigured the output -
+	 * a mode change, a hotplug - and a reload that changed only this one
+	 * setting did nothing at all. Silent, because the reasons a set cannot do
+	 * HDR were already reported when the output came up.
+	 */
+	struct output *output;
+	wl_list_for_each(output, &server.outputs, link) {
+		if (!output_is_usable(output)) {
+			continue;
+		}
+		output_state_setup_hdr(output, /*silent*/ true);
+		/*
+		 * Leave the commit to the next frame instead of doing it here. A
+		 * reload runs whenever the signal arrives, which is often enough
+		 * on top of a page-flip already in flight ("a page-flip is already
+		 * pending"), and a failed commit leaves the render format on the
+		 * long-lived pending state - which is what makes wlr_scene refuse
+		 * direct scan-out, so a film stops reaching a display plane. The
+		 * frame path commits output->pending, so the new colour space
+		 * rides along with the damage once the flip has completed.
+		 */
+		wlr_output_schedule_frame(output->wlr_output);
+	}
 }
 
 static int
-- 
2.47.3

