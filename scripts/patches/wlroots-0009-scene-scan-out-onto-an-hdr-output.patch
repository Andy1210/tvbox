From d95b5d86c8056cccc0ed7e4d8f030d9d95303ca4 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Wed, 5 Aug 2026 10:38:28 +0200
Subject: [PATCH 2/2] scene: scan out onto an HDR output on the compositor's
 policy

Upstream compares the buffer's colour space with the output's before allowing
direct scan-out. That is the right test for a compositor that advertises
wp_color_manager_v1: its clients describe what they render, so the comparison
means something.

Without that protocol every buffer reads as the default sRGB/gamma2.2 whether
or not it is - measured here, a PQ video buffer arrives as tf=GAMMA22 prim=SRGB
- so the comparison rejects everything the moment the output is HDR, and the
plane path collapses into compositing at the one time it is needed most: a 4K
HDR film went from the primary plane to a full-screen composite.

Trade the comparison for a policy the compositor has to keep instead: put an
output in a colour space only while content in that space is on it. This one
does, claiming HDR for the duration of PQ playback and releasing it after, so
what reaches the plane is PQ by construction.
---
 types/scene/wlr_scene.c | 21 +++++++++++++++++----
 1 file changed, 17 insertions(+), 4 deletions(-)

diff --git a/types/scene/wlr_scene.c b/types/scene/wlr_scene.c
index e5c43e6..2966da2 100644
--- a/types/scene/wlr_scene.c
+++ b/types/scene/wlr_scene.c
@@ -2030,10 +2030,23 @@ static void scene_buffer_send_dmabuf_feedback(const struct wlr_scene *scene,
 
 static bool color_management_is_scanout_allowed(const struct wlr_output_image_description *img_desc,
 		const struct wlr_scene_buffer *buffer) {
-	// Disallow scanout if the output has colorimetry information but buffer
-	// doesn't; allow it only if the output also lacks it.
-	if (buffer->transfer_function == 0 && buffer->primaries == 0) {
-		return img_desc == NULL;
+	// When the output carries colorimetry, scan out whatever is on it.
+	//
+	// Upstream compares the buffer's colour space with the output's, which is
+	// the right test for a compositor that advertises wp_color_manager_v1: its
+	// clients describe what they render, so the comparison means something.
+	// Without that protocol every buffer reads as the default sRGB/gamma2.2
+	// whether or not it is - measured here, a PQ video buffer arrives as
+	// tf=GAMMA22 prim=SRGB - so the comparison rejects everything the moment the
+	// output is HDR, and the plane path collapses into compositing at the one
+	// time it is needed most.
+	//
+	// This trades the comparison for a policy the compositor has to keep: put an
+	// output in a colour space only while content in that space is on it. Ours
+	// does - HDR is claimed for the duration of PQ playback and released after -
+	// so what reaches the plane is PQ by construction.
+	if (img_desc != NULL) {
+		return true;
 	}
 
 	// If the output has colorimetry information, the buffer must match it for
