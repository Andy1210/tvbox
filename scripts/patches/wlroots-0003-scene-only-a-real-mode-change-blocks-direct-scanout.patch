From 0683bd624ea72675d50ad55879f57c92c65a8be9 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Mon, 3 Aug 2026 18:00:00 +0200
Subject: [PATCH 3/6] scene: only a real mode change blocks direct scan-out

Direct scan-out is refused whenever the output state carries MODE, ENABLED or
RENDER_FORMAT, because legacy DRM cannot modeset with a client buffer attached.

A compositor that rebuilds its pending state from a saved output configuration
sets all three on every frame while changing none of them, and then never scans
out anything, on any hardware. Compare the values the way output_compare_state()
does, and test allow_reconfiguration - which is what the DRM backend actually
keys its modeset off, and which is a request rather than a difference.
---
 types/scene/wlr_scene.c | 48 ++++++++++++++++++++++++++++++++++++++---
 1 file changed, 45 insertions(+), 3 deletions(-)

diff --git a/types/scene/wlr_scene.c b/types/scene/wlr_scene.c
index 7bc8b76..6fcc61d 100644
--- a/types/scene/wlr_scene.c
+++ b/types/scene/wlr_scene.c
@@ -2058,6 +2058,40 @@ enum scene_direct_scanout_result {
 	SCANOUT_SUCCESS,
 };
 
+// Does this state actually change the mode, the enable or the render format, or
+// does it just restate what the output already has? Only the former is a modeset
+// that direct scan-out has to keep away from. The caller checks
+// allow_reconfiguration separately: that is a request rather than a difference,
+// and it is what the backend actually keys its modeset off.
+static bool state_changes_mode(struct wlr_output *output,
+		const struct wlr_output_state *state) {
+	if (state->committed & WLR_OUTPUT_STATE_MODE) {
+		switch (state->mode_type) {
+		case WLR_OUTPUT_STATE_MODE_FIXED:
+			if (output->current_mode != state->mode) {
+				return true;
+			}
+			break;
+		case WLR_OUTPUT_STATE_MODE_CUSTOM:
+			if (output->width != state->custom_mode.width ||
+					output->height != state->custom_mode.height ||
+					output->refresh != state->custom_mode.refresh) {
+				return true;
+			}
+			break;
+		}
+	}
+	if ((state->committed & WLR_OUTPUT_STATE_ENABLED) &&
+			output->enabled != state->enabled) {
+		return true;
+	}
+	if ((state->committed & WLR_OUTPUT_STATE_RENDER_FORMAT) &&
+			output->render_format != state->render_format) {
+		return true;
+	}
+	return false;
+}
+
 static enum scene_direct_scanout_result scene_entry_try_direct_scanout(
 		struct render_list_entry *entry, struct wlr_output_state *state,
 		const struct render_data *data) {
@@ -2072,9 +2106,17 @@ static enum scene_direct_scanout_result scene_entry_try_direct_scanout(
 		return SCANOUT_INELIGIBLE;
 	}
 
-	if (state->committed & (WLR_OUTPUT_STATE_MODE |
-			WLR_OUTPUT_STATE_ENABLED |
-			WLR_OUTPUT_STATE_RENDER_FORMAT)) {
+	/*
+	 * Legacy DRM will explode if we try to modeset with a direct scanout
+	 * buffer - but a state that merely RE-STATES the mode, the enable and the
+	 * render format the output already has is not a modeset. Compositors that
+	 * rebuild their pending state from a saved output config carry those three
+	 * on every frame (labwc does), and taking the flags at face value costs
+	 * them direct scan-out entirely, forever. Compare the values instead, the
+	 * same way wlroots itself decides which fields a commit really changes.
+	 */
+	if (state->allow_reconfiguration ||
+			state_changes_mode(scene_output->output, state)) {
 		// Legacy DRM will explode if we try to modeset with a direct scanout buffer
 		return SCANOUT_INELIGIBLE;
 	}
