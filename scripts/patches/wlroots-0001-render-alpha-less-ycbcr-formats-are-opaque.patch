From 914cc5cb9cbe46160dd06072c6463ae9ba88f041 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Mon, 3 Aug 2026 18:00:00 +0200
Subject: [PATCH 1/6] render: alpha-less YCbCr formats are opaque

pixel_format_has_alpha() answers from an allowlist of opaque formats and returns
true for anything not on it. pixel_format_is_ycbcr() knows 58 YCbCr formats; four
of them are on that list.

So a compositor handed a 10-bit 4:2:0 video buffer - P030, which is what a
Raspberry Pi HEVC decoder produces - is told it may be translucent, while the
8-bit P010 beside it is not. Everything that depends on knowing better is lost:
occlusion culling keeps drawing what the video covers, and direct scan-out is
refused for a buffer that could have gone straight to a plane.

None of the formats added here has an alpha channel. The ones deliberately left
off are the six that do: AYUV, Y410, Y412, Y416, Y0L0 and Y0L2, whose X-prefixed
siblings are the alpha-less variants and are included.
---
 render/pixel_format.c | 50 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/render/pixel_format.c b/render/pixel_format.c
index c60dd9d..7b98e95 100644
--- a/render/pixel_format.c
+++ b/render/pixel_format.c
@@ -211,10 +211,60 @@ static const uint32_t opaque_pixel_formats[] = {
 	DRM_FORMAT_XBGR2101010,
 	DRM_FORMAT_XBGR16161616F,
 	DRM_FORMAT_XBGR16161616,
+	// YCbCr. Every format pixel_format_is_ycbcr() knows, except the six that
+	// carry alpha: AYUV, Y410, Y412, Y416, Y0L0 and Y0L2.
+	DRM_FORMAT_YUYV,
 	DRM_FORMAT_YVYU,
+	DRM_FORMAT_UYVY,
 	DRM_FORMAT_VYUY,
 	DRM_FORMAT_NV12,
+	DRM_FORMAT_NV15,
+	DRM_FORMAT_NV16,
+	DRM_FORMAT_NV20,
+	DRM_FORMAT_NV21,
+	DRM_FORMAT_NV24,
+	DRM_FORMAT_NV30,
+	DRM_FORMAT_NV42,
+	DRM_FORMAT_NV61,
 	DRM_FORMAT_P010,
+	DRM_FORMAT_P012,
+	DRM_FORMAT_P016,
+	DRM_FORMAT_P030,
+	DRM_FORMAT_P210,
+	DRM_FORMAT_Q401,
+	DRM_FORMAT_Q410,
+	DRM_FORMAT_S010,
+	DRM_FORMAT_S012,
+	DRM_FORMAT_S016,
+	DRM_FORMAT_S210,
+	DRM_FORMAT_S212,
+	DRM_FORMAT_S216,
+	DRM_FORMAT_S410,
+	DRM_FORMAT_S412,
+	DRM_FORMAT_S416,
+	DRM_FORMAT_VUY888,
+	DRM_FORMAT_VUY101010,
+	DRM_FORMAT_X0L0,
+	DRM_FORMAT_X0L2,
+	DRM_FORMAT_XVYU2101010,
+	DRM_FORMAT_XVYU12_16161616,
+	DRM_FORMAT_XVYU16161616,
+	DRM_FORMAT_XYUV8888,
+	DRM_FORMAT_Y210,
+	DRM_FORMAT_Y212,
+	DRM_FORMAT_Y216,
+	DRM_FORMAT_YUV410,
+	DRM_FORMAT_YUV411,
+	DRM_FORMAT_YUV420,
+	DRM_FORMAT_YUV420_8BIT,
+	DRM_FORMAT_YUV420_10BIT,
+	DRM_FORMAT_YUV422,
+	DRM_FORMAT_YUV444,
+	DRM_FORMAT_YVU410,
+	DRM_FORMAT_YVU411,
+	DRM_FORMAT_YVU420,
+	DRM_FORMAT_YVU422,
+	DRM_FORMAT_YVU444,
 };
 
