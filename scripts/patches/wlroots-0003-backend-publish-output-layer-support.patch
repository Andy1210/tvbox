From 0efe6ab6a301d6f21027d34f31bcea0c43a1457c Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Mon, 3 Aug 2026 18:00:00 +0200
Subject: [PATCH 3/6] backend: publish whether a backend can display output
 layers

wlr_output_layer_create() succeeds everywhere - it only fails on OOM - and
whether the layers are shown is answered per commit, in
wlr_output_layer_state.accepted. That works for a backend that refuses the state,
which the nested backends do: they leave WLR_OUTPUT_STATE_LAYERS out of
SUPPORTED_OUTPUT_STATE and the commit fails outright. It does not work for the
DRM backend without libliftoff, which accepts the commit and displays nothing.

A compositor therefore has no way to find out whether an offload is possible
before paying a frame with a missing surface to learn. Publish it next to the
timeline capability.
---
 backend/drm/drm.c     | 1 +
 include/wlr/backend.h | 3 +++
 2 files changed, 4 insertions(+)

diff --git a/backend/drm/drm.c b/backend/drm/drm.c
index 6142ced..d976871 100644
--- a/backend/drm/drm.c
+++ b/backend/drm/drm.c
@@ -123,6 +123,7 @@ bool check_drm_features(struct wlr_drm_backend *drm) {
 	} else {
 		drm->supports_tearing_page_flips = drmGetCap(drm->fd, DRM_CAP_ATOMIC_ASYNC_PAGE_FLIP, &cap) == 0 && cap == 1;
 		drm->backend.features.timeline = drmGetCap(drm->fd, DRM_CAP_SYNCOBJ_TIMELINE, &cap) == 0 && cap == 1;
+	drm->backend.features.output_layers = drm->iface == &liftoff_iface;
 	}
 
 	if (env_parse_bool("WLR_DRM_NO_MODIFIERS")) {
diff --git a/include/wlr/backend.h b/include/wlr/backend.h
index 31588ca..9d4171c 100644
--- a/include/wlr/backend.h
+++ b/include/wlr/backend.h
@@ -38,6 +38,9 @@ struct wlr_backend {
 	struct {
 		// Whether wait/signal timelines are supported in output commits
 		bool timeline;
+		// Whether output layers can be displayed. False means a layer will
+		// never be accepted, so there is no point setting one up.
+		bool output_layers;
 	} features;
 
 	struct {
