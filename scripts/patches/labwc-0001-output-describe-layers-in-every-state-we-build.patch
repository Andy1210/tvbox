From 78f6867a8427f292b02b5eda4b7dda2c6cf8748b Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Mon, 3 Aug 2026 18:00:00 +0200
Subject: [PATCH] output: describe the output layers in every state we build

wlroots requires every output test and commit to describe every layer on the
output. The states labwc builds itself - the render-format probe, the adaptive
sync probe, an output-management config - know nothing about layers, which is
harmless until something creates one and fatal immediately after: every test
fails.

A failed render-format probe then leaves the format at the last candidate it
tried, and no swapchain can be created for it at all, so the errors that follow
blame colour formats the renderer never supported.

Describe the layers, disabled, in the states that are asking about modes and
formats, and put back the working format when every candidate fails.
---
 include/output-state.h | 13 +++++++++++++
 include/output.h       |  7 +++++++
 src/output-state.c     | 39 +++++++++++++++++++++++++++++++++++++++
 src/output.c           | 11 +++++++++++
 4 files changed, 70 insertions(+)

diff --git a/include/output-state.h b/include/output-state.h
index b88dff5..20e519f 100644
--- a/include/output-state.h
+++ b/include/output-state.h
@@ -6,8 +6,21 @@
 
 struct output;
 
+struct wlr_output_state;
+
 void output_state_init(struct output *output);
 
+/**
+ * output_state_describe_layers() - list the output's layers in a state
+ *
+ * wlroots requires every test and commit to describe every layer on the
+ * output. States we build ourselves (mode and format probes, adaptive sync,
+ * output-management configs) know nothing about layers, so they get them all
+ * disabled. A state that already describes its layers is left untouched.
+ */
+void output_state_describe_layers(struct output *output,
+	struct wlr_output_state *state);
+
 bool output_state_commit(struct output *output);
 
 #endif // LABWC_OUTPUT_STATE_H
diff --git a/include/output.h b/include/output.h
index c17defa..218686a 100644
--- a/include/output.h
+++ b/include/output.h
@@ -11,6 +11,13 @@ struct output {
 	struct wl_list link; /* server.outputs */
 	struct wlr_output *wlr_output;
 	struct wlr_output_state pending;
+	/*
+	 * Layer states handed to wlroots with every output test/commit we build
+	 * ourselves. Owned by the output because a state may be tested now and
+	 * committed later, and wlroots keeps the pointer rather than a copy.
+	 */
+	struct wlr_output_layer_state *layer_states;
+	size_t layer_states_len;
 	struct wlr_scene_output *scene_output;
 	struct wlr_scene_tree *layer_tree[LAB_NR_LAYERS];
 	struct wlr_scene_tree *layer_popup_tree;
diff --git a/src/output-state.c b/src/output-state.c
index 37ebde8..a2ba964 100644
--- a/src/output-state.c
+++ b/src/output-state.c
@@ -1,11 +1,49 @@
 // SPDX-License-Identifier: GPL-2.0-only
 
 #include "output-state.h"
+#include <stdlib.h>
 #include <wlr/types/wlr_output.h>
+#include <wlr/types/wlr_output_layer.h>
 #include <wlr/types/wlr_output_management_v1.h>
 #include <wlr/util/log.h>
 #include "output.h"
 
+/*
+ * Describe every layer on the output, disabled, unless the state already says
+ * what its layers should be. wlroots rejects a test or commit that mentions
+ * fewer layers than the output has, and a compositor that cannot get a state
+ * accepted stops drawing entirely.
+ */
+void
+output_state_describe_layers(struct output *output, struct wlr_output_state *state)
+{
+	if (state->committed & WLR_OUTPUT_STATE_LAYERS) {
+		return;
+	}
+
+	size_t len = wl_list_length(&output->wlr_output->layers);
+	if (len == 0) {
+		return;
+	}
+
+	if (len != output->layer_states_len) {
+		struct wlr_output_layer_state *grown =
+			realloc(output->layer_states, len * sizeof(*grown));
+		if (!grown) {
+			return;
+		}
+		output->layer_states = grown;
+		output->layer_states_len = len;
+	}
+
+	size_t i = 0;
+	struct wlr_output_layer *layer;
+	wl_list_for_each(layer, &output->wlr_output->layers, link) {
+		output->layer_states[i++] = (struct wlr_output_layer_state){ .layer = layer };
+	}
+	wlr_output_state_set_layers(state, output->layer_states, len);
+}
+
 void
 output_state_init(struct output *output)
 {
@@ -31,6 +69,7 @@ output_state_init(struct output *output)
 bool
 output_state_commit(struct output *output)
 {
+	output_state_describe_layers(output, &output->pending);
 	bool committed =
 		wlr_output_commit_state(output->wlr_output, &output->pending);
 	if (committed) {
diff --git a/src/output.c b/src/output.c
index 2eab8ec..99b0f10 100644
--- a/src/output.c
+++ b/src/output.c
@@ -87,12 +87,22 @@ uint32_t output_formats_10bit[] = {
 static bool
 output_set_render_format(struct output *output, uint32_t candidates[], size_t count)
 {
+	output_state_describe_layers(output, &output->pending);
+	uint32_t working = output->wlr_output->render_format;
 	for (size_t i = 0; i < count; i++) {
 		wlr_output_state_set_render_format(&output->pending, candidates[i]);
 		if (wlr_output_test_state(output->wlr_output, &output->pending)) {
 			return true;
 		}
 	}
+	/*
+	 * Every candidate failed. Leaving the last one pending is what turns a
+	 * failed probe into a dead output: the format stays on the state, no
+	 * swapchain can be created for it, and every frame after this fails with
+	 * "Failed to pick primary buffer format". Put back the one that was
+	 * working before we started asking.
+	 */
+	wlr_output_state_set_render_format(&output->pending, working);
 	return false;
 }
 
@@ -1286,6 +1296,7 @@ void
 output_enable_adaptive_sync(struct output *output, bool enabled)
 {
 	wlr_output_state_set_adaptive_sync_enabled(&output->pending, enabled);
+	output_state_describe_layers(output, &output->pending);
 	if (!wlr_output_test_state(output->wlr_output, &output->pending)) {
 		wlr_output_state_set_adaptive_sync_enabled(&output->pending, false);
 		wlr_log(WLR_DEBUG,
-- 
