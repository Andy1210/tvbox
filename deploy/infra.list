# The ONE list of "infra" files - everything outside shell/ that a box needs.
# Repo-relative paths; basenames land flat in ~/.tvbox/ (and in a release
# tarball's infra/). Consumed by:
#   deploy/deploy.sh              dev deploy rsync
#   scripts/copy-infra.sh         shared copier (make-release.sh, build-image.sh, image.yml)
#   shell/updater.js              INFRA_FILES allowlist - cross-checked by shell/updater.test.js
# Add a file here and it ships in EVERY channel; the updater test fails if
# updater.js's allowlist drifts from this list.
cec/cec_uinput_bridge.py
cec/cec_vendor_shim.c
remote/remote_input_bridge.py
gamepad/gamepad_shim.py
remote/firetv_remote_ir.py
remote/keymap_compile.py
remote/ir_protocols.py
remote/firetv_hid_probe.py
remote/firetv_tv_codes.example.json
deploy/run-shell.sh
deploy/tvbox-diag.sh
deploy/tvbox-safemode.sh
deploy/labwc-autostart
deploy/labwc-environment
deploy/cursor_idle_hide.py
deploy/tvbox
deploy/provision.sh
scripts/install-libcec8.sh
# labwc + wlroots with display-plane offload: the build script, the ten patches
# it applies, and the session wrapper that runs whichever compositor is installed.
# Patch basenames carry their own ordering - they land flat next to the script.
scripts/install-labwc-planes.sh
scripts/patches/wlroots-0001-render-p030-is-opaque.patch
scripts/patches/wlroots-0002-drm-colour-props-on-the-liftoff-interface.patch
scripts/patches/wlroots-0003-backend-publish-output-layer-support.patch
scripts/patches/wlroots-0004-scene-offload-the-top-surface-to-an-output-layer.patch
scripts/patches/wlroots-0005-drm-give-libliftoff-a-deadline-it-can-finish-in.patch
scripts/patches/wlroots-0006-drm-do-not-arm-the-composition-layer-when-offloading.patch
scripts/patches/wlroots-0007-drm-a-modeset-is-not-a-failed-cursor-scan-out.patch
scripts/patches/wlroots-0008-render-gles2-report-the-output-colour-transform.patch
scripts/patches/wlroots-0009-scene-scan-out-onto-an-hdr-output.patch
scripts/patches/labwc-0001-output-do-not-leave-a-failed-render-format.patch
deploy/tvbox-compositor
deploy/tvbox-cec.service
deploy/tvbox-remote.service
deploy/tvbox-gamepad.service
deploy/tvbox-flatpak-update.service
deploy/tvbox-flatpak-update.timer
# System (root) units + the greetd drop-in for the diagnostics/safe-mode pair.
# They ship here so every channel carries them, but only provision.sh and the
# image stage install them under /etc - an OTA release cannot touch root paths, so
# on an OTA-only box these land in ~/.tvbox/ and take effect at the next provision.
deploy/tvbox-diag.service
deploy/tvbox-diag.timer
deploy/tvbox-safemode.service
deploy/tvbox-safemode-screen.service
deploy/greetd-tvbox-safemode.conf
